# ---------- Supabase (Project Settings -> API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx      # or the legacy anon key
# Server-side only (Vercel env var WITHOUT NEXT_PUBLIC). The server reads/writes data with it after checking
# the person's role; it never reaches the browser. Also used by `npm run import` on your machine.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Sign-in ----------
# Demo: no accounts, the sign-in page lets you pick a persona (admin, CEO, project director, finance, HR, employee).
DEMO_MODE=1
DEMO_PASSCODE=                       # optional: adds a passcode box on the demo page
# Real sign-in (DEMO_MODE empty): Supabase email link, invite-only. Roles come from mis.user_roles;
# emails listed here are always admins. Everyone else without a role row is an employee.
ADMIN_EMAILS=
ALLOWED_EMAILS=                      # optional extra gate: emails or @domains, comma-separated

# ---------- AI (server-side only) ----------
ANTHROPIC_API_KEY=                   # Ask tab and the AI-written briefs; without it, rule text is shown
ASK_MODEL=                           # default claude-opus-5-5
INSIGHTS_MODEL=                      # default = ASK_MODEL
